{
    "name": "harness-summit",
    "version": "1.0.1",
    "description": "Let Claude Code, Codex, OpenCode, pi and OMP sessions on one machine message each other and wake idle agents. An MCP server plus small per-harness adapters, all through plain files.",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "claude-code",
        "codex",
        "opencode",
        "pi",
        "oh-my-pi",
        "ai-agents",
        "multi-agent",
        "coding-agents",
        "agent-communication",
        "inter-agent-messaging",
        "herdr"
    ],
    "author": "anthonyleung-dev",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anthonyleung-dev/harness-summit.git"
    },
    "homepage": "https://github.com/anthonyleung-dev/harness-summit#readme",
    "bugs": {
        "url": "https://github.com/anthonyleung-dev/harness-summit/issues"
    },
    "type": "module",
    "files": [
        "dist",
        "adapters",
        "README.md",
        "LICENSE"
    ],
    "bin": {
        "harness-summit": "dist/cli.js"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node dist/cli.js gen-plugin",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && vitest run",
        "test:unit": "vitest run test/unit",
        "test:integration": "npm run build && vitest run test/integration",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "dev": "tsx src/cli.ts",
        "prepublishOnly": "npm test"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "jsonc-parser": "^3.3.1",
        "smol-toml": "^1.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^26.6.5",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    }
}
